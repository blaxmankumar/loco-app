# Copy this file to .env.local (or paste values directly into src/firebase.js)
# Get these 6 values from: https://console.firebase.google.com -> Project Settings -> Your apps -> Web app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated Admin email(s) that get exclusive Admin Control Center access
VITE_LOCO_ADMIN_EMAILS=admin@loco.secr.in
